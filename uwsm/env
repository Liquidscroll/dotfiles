# Environment variables used by the uwsm utilities and Hyprland.
# setup.sh places this file at $XDG_CONFIG_HOME/uwsm/env so it can be sourced
# by login or window manager startup scripts.

# Set the default cursor size for the session
export XCURSOR_SIZE=24

# Use the proprietary NVIDIA drivers for VA-API and GLX
export LIBVA_DRIVER_NAME=nvidia
export __GLX_VENDOR_LIBRARY_NAME=nvidia

# Preferred text editors
export EDITOR=nvim
export VISUAL=nvim

# Base directories following the XDG specification
export XDG_CACHE_HOME=$HOME/.cache
export XDG_CONFIG_HOME=$HOME/.config
export XDG_DATA_HOME=$HOME/.local/share
export XDG_STATE_HOME=$HOME/.local/state

# Use Wayland for GUI toolkits when possible
export GDK_BACKEND=wayland,x11,*
export QT_QPA_PLATFORM=wayland;xcb
export SDL_VIDEODRIVER=wayland
