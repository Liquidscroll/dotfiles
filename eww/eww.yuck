;; Eww Widgets Configuration
;;
;; This file defines the widgets, variables, listeners, polls, and window
;; for a vertical Eww bar.

;; Global Variables
(defvar bar_width 48)       ;; Defines the width of the main vertical bar.
;(defvar half_bar_width "24px")  ;; Defines half the width of the bar (currently unused but kept for potential future use).
(defvar audio_sink_icon "")    ;; Icon representing the current audio sink.

;; Main Vertical Bar Structure
(defwidget vbar [screen monitor]
  (centerbox :orientation "v"
    (box :class "segment-top" :valign "start"
      (top_segment :screen screen :monitor monitor))
    (box :class "segment-middle" :valign "center"
      (middle_segment :screen screen))
    (box :class "segment-bottom" :valign "end"
      (bottom_segment :screen screen)) 
  ))

;; Top Segment Widgets
(defwidget top_segment [screen monitor]
  (box :orientation "v"
    (scroll :vscroll true  ;; Allows scrolling if systray items overflow
      (systray :class "systray" :orientation "v" :icon-size 13 :spacing 4))
    (workspaces_widget :monitor monitor) 
  ))

(defwidget workspaces_widget [monitor]
  (box :orientation "v" :class "workspaces"
    (for space in {workspaces_data[monitor]} 
      (button
        :class "${space.focused ? "active" : "inactive"}"
        :onclick "hyprctl dispatch workspace ${space.id}"
        :hexpand false
        (label :text "${space.name}")))))

;; Middle Segment Widgets
(defwidget middle_segment [] (time_widget)) 

(defwidget time_widget []
  (box :orientation "v" :class "time"
    hour_poll min_poll sec_poll 
  ))

(defwidget metric_group [?screen] 
    (box :orientation "v" :space-evenly true :spacing 3 :visible {screen == 1}
        (children)
    )
)

;; Bottom Segment Widgets
(defwidget bottom_segment [screen] 
  (box :orientation "v" :valign "end" :space-evenly false :spacing "5"
    (metric_group :screen screen
    (volume_widget)
    (box :orientation "h" :space-evenly true :class "metric-container"
      (metric_widget :icon "" :font-size 1 ; Disk icon
        "${round(EWW_DISK["/"].used_perc, 0)}%")
      (metric_widget :icon "" :font-size 1 ; RAM icon
        "${round(EWW_RAM.used_mem_perc, 0)}%"))
    (box :orientation "h" :space-evenly true :class "metric-container"
      (metric_widget :icon "󰻠" :font-size 1 ; CPU icon
        "${round(EWW_CPU.avg, 0)}%")
      (metric_widget :icon "󰘚" :font-size 1 ; GPU icon
        gpu_poll)) 
    )
      (date_widget))
)

;; Reusable Metric Widget
(defwidget metric_widget [icon ?font-size]
  (box :orientation "v" :class "metric" :halign "center"
    (label :class "metric-icon"
           :style {font-size != "" ? "font-size: ${font-size}rem;" : ""}
           :text icon)
    (children)))

; CHECK THIS
;; Volume Control Widget
(defwidget volume_widget []
  (box :orientation "v" :class "volume-metric" :space-evenly false :valign "fill" :vexpand false
    ;; Volume slider
    (scale :orientation "h" :min 0 :max 101 :value current_volume_poll 
           :onchange "wpctl set-volume -l 1 @DEFAULT_AUDIO_SINK@ $(echo {} | sed 's/\\..*//g')%")
    ;; Eventbox for scroll-based volume adjustment and buttons
    (eventbox
      :onscroll "if [[ '{}' == 'up' ]]; then wpctl set-volume -l 1 @DEFAULT_AUDIO_SINK@ 2.5%+; else wpctl set-volume -l 1 @DEFAULT_AUDIO_SINK@ 2.5%-; fi"
      :vexpand true :valign "fill"
      (box :orientation "v" :valign "fill" :vexpand true
        ;; Button to open Tofi-based sound chooser and toggle audio details script
        ;;;;;; TODO:
        ; Change this so that left click mutes/unmutes volume
        ; Right click will open tofi based menu to choose device (i.e. speakers or headset)

        ;;; TODO?:
        ; Generalise this, so that I can reuse it for microphone later on.
        (button :class "audio-sink-button"
                :onclick "./scripts/audio_details.py mute"
                ;; User comment: make this tofi etc
                ;rofi -theme ~/.config/rofi/launchers/type-4/style-2.rasi -show rofi-sound -modi 'rofi-sound:rofi-sound-output-chooser' &"
                :onrightclick "./scripts/audio_details.py menu"
          audio_sink_icon) 
        ;; Button to open pavucontrol and display current volume percentage
        (button :class "volume-percent-button"
                :onclick "pavucontrol &"
          "${current_volume_poll}%")))))

;; Date Widget
(defwidget date_widget []
  (box :orientation "v" :halign "center" :valign "end"
    day_word_poll day_poll month_poll year_poll 
  ))

;; Large Symbol Widget
(defwidget large-sym [sym]
  (label :class "metric-icon large-symbol" :text sym))

;; Data Listeners & Pollers

(deflisten workspaces_data
  :initial '{"HDMI-A-2": [], "HDMI-A-1": []}' 
  "./scripts/hyprworkspaces.py")

;; Volume Data Listener
(deflisten current_volume_poll :initial "0" "./scripts/audio_details.py volume")
;; Time Pollers
(defpoll hour_poll :interval "1s" "date +%H")
(defpoll min_poll  :interval "1s" "date +%M")
(defpoll sec_poll  :interval "1s" "date +%S")

;; Date Pollers
(defpoll day_word_poll :interval "10m" "date +%a | tr [:upper:] [:lower:]") 
(defpoll day_poll      :interval "10m" "date +%d")                          
(defpoll month_poll    :interval "1h"  "date +%m")                          
(defpoll year_poll     :interval "1h"  "date +%y")                          

;; GPU Utilization Poller
(defpoll gpu_poll :interval "15s"
  "nvidia-smi --query-gpu=utilization.gpu --format=csv,noheader | awk '{printf(\"%s%\", $1)}'")

;; Window Definition
(defwindow primary_bar
  :monitor '["<primary>", "HDMI-A-2", 0]'
  :stacking "overlay" 
  :geometry (geometry :x 0
                      :y 0
                      :width "48px" 
                      :height "100%"
                      :anchor "center right")
  :exclusive true 
  (vbar :screen 1 :monitor "HDMI-A-2") 
)

(defwindow secondary_bar
    :monitor '["<secondary>", "HDMI-A-1", 1]'
    :stacking "overlay"
    :geometry (geometry :x 0
                        :y 0
                        :width "48px" 
                        :height "100%"
                        :anchor "center left")
    :exclusive true
    (vbar :screen 2 :monitor "HDMI-A-1")
)
