;; Eww Widgets Configuration
;;
;; This file defines the widgets, variables, listeners, polls, and window
;; for a vertical Eww bar.

;; Global Variables
(defvar bar_width 48)       ;; Defines the width of the main vertical bar.
;(defvar half_bar_width "24px")  ;; Defines half the width of the bar (currently unused but kept for potential future use).
(defvar audio_sink_icon "")    ;; Icon representing the current audio sink.
(defvar audio_source_icon "")

(defvar show_sys_details false)

;; Main Vertical Bar Structure
(defwidget vbar [screen monitor]
  (box :orientation "h" :space-evenly false 
  (revealer :visible "${show_sys_details && screen == 1}" :reveal show_sys_details :transition "slideleft"
  (system_details))
    (centerbox :orientation "v" :hexpand false
    (box :class "segment-top" :valign "start"
      (top_segment :screen screen :monitor monitor))
    (box :class "segment-middle" :valign "center"
      (middle_segment :screen screen))
    (box :class "segment-bottom" :valign "end" :hexpand false
      (bottom_segment :screen screen))
  )
  )
)



;; Top Segment Widgets
(defwidget top_segment [screen monitor]
  (box :orientation "v"
    (scroll :vscroll true  ;; Allows scrolling if systray items overflow
      (systray :class "systray" :orientation "v" :icon-size 13 :spacing 4))
    (workspaces_widget :monitor monitor)
  ))

(defwidget workspaces_widget [monitor]
  (box :orientation "v" :class "workspaces"
    (for space in {workspaces_data[monitor]}
      (button
        :class "${space.focused ? "active" : "inactive"}"
        :onclick "hyprctl dispatch workspace ${space.id}"
        :hexpand false
        (label :text "${space.name}")))))

;; Middle Segment Widgets
(defwidget middle_segment [] (time_widget))

(defwidget time_widget []
  (box :orientation "v" :class "time"
    hour_poll min_poll sec_poll
  ))

(defwidget metric_group [?screen]
    (box :valign "end" :orientation "v" :space-evenly false :spacing 3 :visible {screen == 1}
        (children)
    )
)

(defwidget temp_group [?screen]
    (box :orientation "v" :space-evenly true :spacing 3 :visible {screen == 2}
        (children)
    )
)

;; Bottom Segment Widgets
(defwidget bottom_segment [screen]
  (box :orientation "v" :valign "end" :space-evenly false :spacing "3"
    (metric_group :screen screen 
    (mic_widget)
    (volume_widget)
    (eventbox :onclick "eww update show_sys_details=${show_sys_details == true ? false : true}"
      (box :orientation "v" :space-evenly: true 
        (box :orientation "h" :space-evenly true :class "metric-container"
          (metric_widget :icon "" :font-size 1 ; Disk icon
            :text "${round(EWW_DISK["/"].used_perc, 0)}%")
          (metric_widget :icon "" :font-size 1 ; RAM icon
            :text "${round(EWW_RAM.used_mem_perc, 0)}%"))
        (box :orientation "h" :space-evenly true :class "metric-container"
          (metric_widget :icon "󰻠" :font-size 1 ; CPU icon
            :text "${round(EWW_CPU.avg, 0)}%")
          (metric_widget :icon "󰘚" :font-size 1 ; GPU icon
            :text "${gpu_poll}"))
      )
    ))
    (temp_group :screen screen
      (bottom_segment_temps)
    )
    (date_widget)
  )
)

(defwidget bottom_segment_temps []
  (eventbox :onclick "eww update show_sys_details=!show_sys_details"
    (box :orientation "v" :space-evenly: true :class "metric-container"
        (metric_widget :icon "󰻠" :font-size 1 ; CPU temp 
          :style "color: ${cpu_temp_poll <= 20 ? '#81b023' :
                           cpu_temp_poll <= 60 ? '#53a8bd' :
                           cpu_temp_poll <= 80 ? '#c29661' : 'c72259'}"
          :text "${cpu_temp_poll}󰔄")
        (metric_widget :icon "󰘚" :font-size 1 ; GPU temp
          :style "color: ${gpu_temp_poll <= 20 ? '#81b023' :
                           gpu_temp_poll <= 60 ? '#53a8bd' :
                           gpu_temp_poll <= 80 ? '#c29661' : 'c72259'}"
          :text "${gpu_temp_poll}󰔄")
    )
  )
)

;; Reusable Metric Widget
(defwidget metric_widget [icon text ?font-size]
  (box :orientation "v" :class "metric" :halign "center"
    (label :class "metric-icon"
           :style {font-size != "" ? "font-size: ${font-size}rem;" : ""}
           :text icon)
    (label :text text :limit-width 4)))

; CHECK THIS
;; Volume Control Widget
(defwidget volume_widget []
  (box :orientation "v" :class "volume-metric" :space-evenly false :valign "end" :vexpand false
    ;; Volume slider
    (scale :orientation "h" :min 0 :max 101 :value current_volume_poll
           :onchange "wpctl set-volume -l 1 @DEFAULT_AUDIO_SINK@ $(echo {} | sed 's/\\..*//g')%")
    ;; Eventbox for scroll-based volume adjustment and buttons
    (eventbox
      :onscroll "if [[ '{}' == 'up' ]]; then wpctl set-volume -l 1 @DEFAULT_AUDIO_SINK@ 2.5%+; else wpctl set-volume -l 1 @DEFAULT_AUDIO_SINK@ 2.5%-; fi"
      :vexpand true :valign "fill"
      (box :orientation "v" :valign "fill" :vexpand true
        ;;; TODO?:
        ; Generalise this, so that I can reuse it for microphone later on.
        (button :class "audio-sink-button"
                :onclick "./scripts/audio_controller.sh mute output"
                :onrightclick "./scripts/audio_controller.sh menu output"
          audio_sink_icon)
        ;; Button to open pavucontrol and display current volume percentage
        ;; TODO?: Make this a slider that pops out on click
        (button :class "volume-percent-button"
                :onclick "pavucontrol &"
          "${current_volume_poll}%")))))

(defwidget mic_widget []
  (box :orientation "v" :class "mic-metric" :space-evenly false :valign "end" :vexpand false
    ;; Volume slider
    (scale :orientation "h" :min 0 :max 101 :value current_mic_poll
           :onchange "wpctl set-volume -l 1 @DEFAULT_AUDIO_SOURCE@ $(echo {} | sed 's/\\..*//g')%")
    ;; Eventbox for scroll-based volume adjustment and buttons
    (eventbox
      :onscroll "if [[ '{}' == 'up' ]]; then wpctl set-volume -l 1 @DEFAULT_AUDIO_SOURCE@ 2.5%+; else wpctl set-volume -l 1 @DEFAULT_AUDIO_SOURCE@ 2.5%-; fi"
      :vexpand true :valign "fill"
      (box :orientation "v" :valign "fill" :vexpand true
        ;;; TODO?:
        ; Generalise this, so that I can reuse it for microphone later on.
        (button :class "audio-source-button"
                :onclick "./scripts/audio_controller.sh mute input"
                :onrightclick "./scripts/audio_controller.sh menu input"
          audio_source_icon)
        ;; Button to open pavucontrol and display current volume percentage
        ;; TODO?: Make this a slider that pops out on click
        (button :class "mic-percent-button"
                :onclick "pavucontrol &"
          "${current_mic_poll}%")))))

;; Date Widget
(defwidget date_widget []
  (box :orientation "v" :halign "center" :valign "end"
    day_word_poll day_poll month_poll year_poll
  ))

;; Large Symbol Widget
(defwidget large-sym [sym]
  (label :class "metric-icon large-symbol" :text sym))

;; Data Listeners & Pollers

(deflisten workspaces_data
  :initial '{"HDMI-A-2": [], "HDMI-A-1": []}'
  "./scripts/hyprworkspaces.sh")

;; Volume Data Listener
(deflisten current_volume_poll :initial "0" "./scripts/audio_controller.sh volume output")
(deflisten current_mic_poll :initial "0" "./scripts/audio_controller.sh volume input")
;; Time Pollers
(defpoll hour_poll :interval "1s" "date +%H")
(defpoll min_poll  :interval "1s" "date +%M")
(defpoll sec_poll  :interval "1s" "date +%S")

;; Date Pollers
(defpoll day_word_poll :interval "10m" "date +%a | tr [:upper:] [:lower:]")
(defpoll day_poll      :interval "10m" "date +%d")
(defpoll month_poll    :interval "1h"  "date +%m")
(defpoll year_poll     :interval "1h"  "date +%y")

;; GPU Utilization Poller
;(defpoll gpu_poll :interval "1s"
;  "nvidia-smi --query-gpu=utilization.gpu --format=csv,noheader,nounits | xargs printf '%3d'")
(defpoll gpu_poll :interval "5s"
  "printf '%d%%' $(nvidia-smi --query-gpu=utilization.gpu --format=csv,noheader,nounits)")
(defpoll cpu_temp_poll :interval "5s" 
  "sensors -j 2>/dev/null | jq -r '.\"k10temp-pci-00c3\".Tctl.temp1_input' | xargs printf \"%.1f\"")
(defpoll gpu_temp_poll :interval "5s"  
  "nvidia-smi --query-gpu=temperature.gpu --format=csv,noheader | xargs printf \"%.1f\"")
(defpoll cpu_fan_poll :interval "5s" 
  "sensors 2>/dev/null | awk '/fan1:/ {gsub(\"RPM\", \"\", $2); print $2; exit; }'")
(defpoll gpu_fan_poll :interval "5s" 
  "nvidia-smi --query-gpu=fan.speed --format=csv,noheader,nounits")

;; System Details Widget
(defwidget system_details []
  (box :orientation "v" :class "system-details-panel" :spacing 8
    (box :orientation: "h" :valign "start" :vexpand false :space-evenly true :spacing 10 
      (label :text "System Details" :halign "start")
      (button :halign "end" :hexpand true :class "close-button" :onclick "eww update show_sys_details=false" "")
    )
      (box :orientation "v" :class "detail-circle"
        (box :orientation "v"
          (circular-progress :class "usage-circle" 
          :value "${round(EWW_CPU.avg,0)}" :min 0 :max 100 :thickness 6 :size 64
          :style "color: ${EWW_CPU.avg <= 20 ? '#66d9ef' : 
                           EWW_CPU.avg <= 60 ? '#a6e22e' : 
                           EWW_CPU.avg <= 80 ? '#f4bf75' : '#f92672'}"
          (label :text "${round(EWW_CPU.avg,0)}%"))
          (label :text "CPU" :class "circle-title"))
        (box :orientation "h"
          (label :text "${cpu_temp_poll}°C")
          (label :text "${cpu_fan_poll} RPM" :class "circle-info")))
      (box :orientation "v" :class "detail-circle"
        (circular-progress :class "usage-circle" :value "${round(EWW_RAM.used_mem_perc,0)}" :min 0 :max 100 :thickness 6 :size 64
          :style "color: ${EWW_RAM.used_mem_perc <= 20 ? '#66d9ef' : EWW_RAM.used_mem_perc <= 60 ? '#a6e22e' : EWW_RAM.used_mem_perc <= 80 ? '#f4bf75' : '#f92672'}"
          (label :text "${round(EWW_RAM.used_mem_perc,0)}%"))
        (label :text "RAM" :class "circle-title")
        (label :text 
  "${round((EWW_RAM.used_mem / (1024 * 1024 * 1024)), 1)}/${round((EWW_RAM.total_mem / (1024 * 1024 * 1024)), 1)} GiB" :class "circle-info"))
      (box :orientation "v" :class "detail-circle"
        (circular-progress :class "usage-circle" :value gpu_poll :min 0 :max 100 :thickness 6 :size 64
          :style "color: ${gpu_poll <= 20 ? '#66d9ef' : gpu_poll <= 60 ? '#a6e22e' : gpu_poll <= 80 ? '#f4bf75' : '#f92672'}"
          (label :text "${gpu_poll}%"))
        (label :text "GPU" :class "circle-title")
        (label :text "${gpu_temp_poll}°C | ${gpu_fan_poll}% (FAN)" :class "circle-info")))
)

;; Window Definition
(defwindow primary_bar
  :monitor '["<primary>", "HDMI-A-2", 0]'
  :stacking "overlay"
  :geometry (geometry :x 0
                      :y 0
                      :width "60px"
                      :height "100%"
                      :anchor "center right")
  :exclusive true
  (vbar :screen 1 :monitor "HDMI-A-2")
)

(defwindow secondary_bar
    :monitor '["<secondary>", "HDMI-A-1", 1]'
    :stacking "overlay"
    :geometry (geometry :x 0
                        :y 0
                        :width "48px"
                        :height "100%"
                        :anchor "center left")
    :exclusive true
    (vbar :screen 2 :monitor "HDMI-A-1")  
)

